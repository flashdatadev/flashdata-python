{
  "google_search": {
    "type": "object",
    "required": [
      "source",
      "query"
    ],
    "properties": {
      "source": {
        "type": "string",
        "const": "google_search"
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gl": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Country code. Set explicitly when needed; omitted values use the search provider\u2019s behavior."
          },
          "hl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "pattern": "^[A-Za-z0-9-]+$",
            "description": "Interface language. Set explicitly when needed; omitted values use the search provider\u2019s behavior."
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "num": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Requested result count. Actual count varies by query and search type; no fixed value is added when omitted."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Requested page. Set explicitly for pagination; each page is a separate query."
          },
          "tbs": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "autocorrect": {
            "type": "boolean"
          }
        }
      }
    },
    "description": "Google Search. Supported modes: realtime, async, batch. Provider-specific storage requirements and conditional media options are validated by the server; see the source reference.",
    "externalDocs": {
      "url": "https://flashdata.dev/docs/sources/google_search"
    }
  },
