  "youtube_search": {
    "type": "object",
    "required": [
      "source",
      "query"
    ],
    "properties": {
      "source": {
        "type": "string",
        "const": "youtube_search"
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 20
          },
          "filters": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "360": {
                "type": "boolean"
              },
              "duration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "enum": [
                  "<4",
                  "4-20",
                  ">20"
                ]
              },
              "sort_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "enum": [
                  "rating",
                  "relevance",
                  "view_count",
                  "upload_date"
                ]
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "enum": [
                  "video",
                  "channel",
                  "playlist",
                  "movie"
                ]
              },
              "upload_date": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "enum": [
                  "today",
                  "last_hour",
                  "this_week",
                  "this_month",
                  "this_year"
                ]
              },
              "3d": {
                "type": "boolean"
              },
              "4k": {
                "type": "boolean"
              },
              "creative_commons": {
                "type": "boolean"
              },
              "hd": {
                "type": "boolean"
              },
              "hdr": {
                "type": "boolean"
              },
              "live": {
                "type": "boolean"
              },
              "location": {
                "type": "boolean"
              },
              "purchased": {
                "type": "boolean"
              },
              "subtitles": {
                "type": "boolean"
              },
              "vr180": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "description": "YouTube Search. Supported modes: realtime, async, batch. Provider-specific storage requirements and conditional media options are validated by the server; see the source reference.",
    "externalDocs": {
      "url": "https://flashdata.dev/docs/sources/youtube_search"
    }
  },
