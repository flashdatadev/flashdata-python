      "params"
    ],
    "properties": {
      "source": {
        "type": "string",
        "const": "youtube_download"
      },
      "video_id": {
        "type": "string",
        "minLength": 11,
        "maxLength": 11,
        "pattern": "^[A-Za-z0-9_-]{11}$"
      },
      "params": {
        "type": "object",
