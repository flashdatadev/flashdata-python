      "realtime",
      "async",
      "batch"
    ],
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 20
