include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md openapi.json source-contract.json
recursive-include docs *.md *.rst *.py *.css
recursive-include examples *.py *.txt *.md
recursive-include tests *.py *.json
recursive-include src/flashdata *.json py.typed
include .readthedocs.yaml
prune docs/_build
prune artifacts
global-exclude *.py[cod]
